{
  "name": "devkit-for-strapi",
  "displayName": "DevKit for Strapi",
  "description": "Accurate, project-aware autocomplete, diagnostics, navigation and references for Strapi magic strings (v4 & v5) — in your editor and for your AI agent (MCP).",
  "version": "0.2.3",
  "publisher": "paul-richez",
  "license": "MIT AND LicenseRef-PolyForm-Shield-1.0.0",
  "icon": "assets/icon-128.png",
  "galleryBanner": {
    "color": "#4945FF",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": ["Programming Languages", "Linters", "AI"],
  "keywords": [
    "strapi",
    "strapi v5",
    "strapi v4",
    "cms",
    "intellisense",
    "autocomplete",
    "rename",
    "refactoring",
    "mcp",
    "ai",
    "cursor",
    "copilot"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/PaulRichez/devkit-for-strapi.git"
  },
  "bugs": {
    "url": "https://github.com/PaulRichez/devkit-for-strapi/issues"
  },
  "qna": "https://github.com/PaulRichez/devkit-for-strapi/issues",
  "homepage": "https://devkit-for-strapi.paulrichez.fr",
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:typescript",
    "onLanguage:javascript",
    "onLanguage:typescriptreact",
    "onLanguage:javascriptreact",
    "onLanguage:json"
  ],
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "strapiDevkit.mcp",
        "label": "DevKit for Strapi"
      }
    ],
    "commands": [
      {
        "command": "strapiDevkit.showProjects",
        "title": "DevKit for Strapi: Show Detected Projects"
      },
      {
        "command": "strapiDevkit.rescan",
        "title": "DevKit for Strapi: Rescan Workspace"
      },
      {
        "command": "strapiDevkit.enterLicenseKey",
        "title": "DevKit for Strapi: Enter License Key"
      },
      {
        "command": "strapiDevkit.clearLicenseKey",
        "title": "DevKit for Strapi: Clear License Key"
      },
      {
        "command": "strapiDevkit.routes.refresh",
        "title": "Refresh Routes",
        "category": "DevKit for Strapi",
        "icon": "$(refresh)"
      },
      {
        "command": "strapiDevkit.routes.showAdmin",
        "title": "Show Admin Routes",
        "category": "DevKit for Strapi",
        "icon": "$(eye)"
      },
      {
        "command": "strapiDevkit.routes.hideAdmin",
        "title": "Hide Admin Routes",
        "category": "DevKit for Strapi",
        "icon": "$(eye-closed)"
      },
      {
        "command": "strapiDevkit.routes.goToHandler",
        "title": "Go to Handler",
        "category": "DevKit for Strapi",
        "icon": "$(symbol-method)"
      },
      {
        "command": "strapiDevkit.routes.filter",
        "title": "Filter Routes…",
        "category": "DevKit for Strapi",
        "icon": "$(filter)"
      },
      {
        "command": "strapiDevkit.routes.clearFilter",
        "title": "Clear Routes Filter",
        "category": "DevKit for Strapi",
        "icon": "$(clear-all)"
      },
      {
        "command": "strapiDevkit.routes.copyPath",
        "title": "Copy Route Path",
        "category": "DevKit for Strapi",
        "icon": "$(copy)"
      },
      {
        "command": "strapiDevkit.routes.handlerReferences",
        "title": "Find Handler References",
        "category": "DevKit for Strapi",
        "icon": "$(references)"
      },
      {
        "command": "strapiDevkit.routes.openDeclared",
        "title": "Open Where Declared",
        "category": "DevKit for Strapi",
        "icon": "$(go-to-file)"
      },
      {
        "command": "strapiDevkit.model.copyUid",
        "title": "Copy UID",
        "category": "DevKit for Strapi",
        "icon": "$(copy)"
      },
      {
        "command": "strapiDevkit.model.openField",
        "title": "Open in Schema",
        "category": "DevKit for Strapi",
        "icon": "$(go-to-file)"
      },
      {
        "command": "strapiDevkit.model.showRoutes",
        "title": "Show Routes",
        "category": "DevKit for Strapi",
        "icon": "$(globe)"
      },
      {
        "command": "strapiDevkit.health.validateAll",
        "title": "Check the Whole Project",
        "category": "DevKit for Strapi",
        "icon": "$(checklist)"
      },
      {
        "command": "strapiDevkit.health.replace",
        "title": "Replace with the Suggestion",
        "category": "DevKit for Strapi",
        "icon": "$(lightbulb)"
      },
      {
        "command": "strapiDevkit.plugins.openConfig",
        "title": "Open in config/plugins",
        "category": "DevKit for Strapi",
        "icon": "$(settings-gear)"
      },
      {
        "command": "strapiDevkit.plugins.openEntry",
        "title": "Open Server Entry",
        "category": "DevKit for Strapi",
        "icon": "$(go-to-file)"
      },
      {
        "command": "strapiDevkit.plugins.openPackage",
        "title": "Open package.json",
        "category": "DevKit for Strapi",
        "icon": "$(json)"
      },
      {
        "command": "strapiDevkit.refactor.renameType",
        "title": "Rename…",
        "category": "DevKit for Strapi",
        "icon": "$(edit)"
      },
      {
        "command": "strapiDevkit.refactor.renameField",
        "title": "Rename Field…",
        "category": "DevKit for Strapi",
        "icon": "$(edit)"
      },
      {
        "command": "strapiDevkit.refactor.changeRelation",
        "title": "Change Relation Target…",
        "category": "DevKit for Strapi",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "strapiDevkit.refactor.moveToPlugin",
        "title": "Move to Plugin…",
        "category": "DevKit for Strapi",
        "icon": "$(move)"
      },
      {
        "command": "strapiDevkit.refactor.renameMethod",
        "title": "Rename Action…",
        "category": "DevKit for Strapi",
        "icon": "$(edit)"
      },
      {
        "command": "strapiDevkit.refactor.createPlugin",
        "title": "Create Plugin…",
        "category": "DevKit for Strapi",
        "icon": "$(add)"
      },
      {
        "command": "strapiDevkit.revealInPanel",
        "title": "Reveal in DevKit Panel",
        "category": "DevKit for Strapi",
        "icon": "$(target)"
      },
      {
        "command": "strapiDevkit.model.diagram",
        "title": "Open Relations Diagram",
        "category": "DevKit for Strapi",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "strapiDevkit.configSync.refresh",
        "title": "Refresh Config Sync",
        "category": "DevKit for Strapi",
        "icon": "$(refresh)"
      },
      {
        "command": "strapiDevkit.configSync.compare",
        "title": "Compare with the Database",
        "category": "DevKit for Strapi",
        "icon": "$(database)"
      },
      {
        "command": "strapiDevkit.configSync.openDiff",
        "title": "Open the Database ↔ config/sync Diff",
        "category": "DevKit for Strapi"
      },
      {
        "command": "strapiDevkit.configSync.export",
        "title": "Export from the Database",
        "category": "DevKit for Strapi",
        "icon": "$(arrow-down)"
      },
      {
        "command": "strapiDevkit.configSync.exportAll",
        "title": "Export All Differences",
        "category": "DevKit for Strapi",
        "icon": "$(cloud-download)"
      },
      {
        "command": "strapiDevkit.configSync.import",
        "title": "Import into the Database",
        "category": "DevKit for Strapi",
        "icon": "$(arrow-up)"
      },
      {
        "command": "strapiDevkit.configSync.importPick",
        "title": "Import into the Database…",
        "category": "DevKit for Strapi",
        "icon": "$(cloud-upload)"
      }
    ],
    "configuration": {
      "title": "DevKit for Strapi",
      "properties": {
        "strapiDevkit.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable DevKit for Strapi features."
        },
        "strapiDevkit.diagnostics.enable": {
          "type": "boolean",
          "default": true,
          "description": "Underline invalid Strapi references and obsolete v4 patterns."
        },
        "strapiDevkit.completion.enable": {
          "type": "boolean",
          "default": true,
          "description": "Suggest real Strapi references inside magic-string call sites."
        },
        "strapiDevkit.hover.enable": {
          "type": "boolean",
          "default": true,
          "description": "Show a hover bubble describing what a Strapi magic string resolves to (and service-method signatures)."
        },
        "strapiDevkit.diagnostics.unknownReferenceSeverity": {
          "type": "string",
          "enum": ["error", "warning", "information", "hint"],
          "default": "error",
          "description": "Severity for an unknown/invalid Strapi reference (a UID, service, policy, … that doesn't exist). The 'Strapi v4 pattern in a v5 project' warning is unaffected."
        },
        "strapiDevkit.referencesCodeLens.enable": {
          "type": "boolean",
          "default": true,
          "description": "Show a 'N references (Strapi)' CodeLens on content-types, services, controllers and their methods. These count magic-string and route-handler usages the TypeScript server can't see. Disable if you prefer the built-in TS references lens only."
        },
        "strapiDevkit.referencesCodeLens.methods": {
          "type": "boolean",
          "default": true,
          "description": "Also show the per-method 'N references (Strapi)' CodeLens on service/controller methods. Disable to keep only the file-level lens."
        },
        "strapiDevkit.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Glob patterns of paths to exclude from Strapi project discovery (e.g. 'examples', '**/fixtures/**'). A discovered project whose path matches any pattern is ignored."
        },
        "strapiDevkit.routesCodeLens.enable": {
          "type": "boolean",
          "default": true,
          "description": "Show the routes a controller action handles above it (e.g. 'GET /api/articles/:id'). Click to open the route and see its pipeline in the Routes view."
        },
        "strapiDevkit.model.showPluginTypes": {
          "type": "boolean",
          "default": true,
          "description": "Show the content-types installed plugins declare (read from node_modules) in the Model view, e.g. the fields of plugin::users-permissions.user."
        },
        "strapiDevkit.views.followActiveEditor": {
          "type": "boolean",
          "default": true,
          "description": "When the Model or Routes view is open, reveal the schema, controller or route file of the active editor in it (without taking the focus)."
        },
        "strapiDevkit.runtime.nodePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Pro — the Node that runs your project when DevKit loads its Strapi (config-sync diff, export, import). Empty: `node` on the PATH. Use the Node the project's dependencies were installed with: native modules such as better-sqlite3 are built for it."
        },
        "strapiDevkit.runtime.timeoutSeconds": {
          "type": "number",
          "default": 180,
          "minimum": 30,
          "markdownDescription": "Pro — how long a load of your project's Strapi may take (a first TypeScript compilation can take over a minute)."
        },
        "strapiDevkit.configSync.environment": {
          "type": "string",
          "default": "development",
          "markdownDescription": "Pro — `NODE_ENV` when DevKit loads your project's Strapi for config-sync. An import is refused with `production`."
        },
        "strapiDevkit.configSync.envPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Pro — the `.env` file Strapi loads (`ENV_PATH`). Empty: the project's `.env`."
        },
        "strapiDevkit.configSync.allowRemoteDatabase": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Pro — also load Strapi on a database that is not on this machine. A load does what a start of `strapi develop` does to the database (schema sync, migrations): leave this off unless you are sure."
        },
        "strapiDevkit.configSync.followRefactors": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "Pro — with strapi-plugin-config-sync, renames and moves also update the `config/sync` files they concern (roles' permissions, content-manager views), in the same plan as the code. Turn it off for a project whose `config/sync` is not yours to change (exported from another environment): plans then leave those files, and say which still use the old names. The bundled MCP server follows it; an agent can pass `configSync` on a call. Nothing is imported into the database without you."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "strapiDevkit",
          "title": "DevKit for Strapi",
          "icon": "assets/activity.svg"
        }
      ]
    },
    "views": {
      "strapiDevkit": [
        {
          "id": "strapiDevkit.health",
          "name": "Health",
          "contextualTitle": "DevKit for Strapi",
          "icon": "assets/activity.svg"
        },
        {
          "id": "strapiDevkit.routes",
          "name": "Routes",
          "contextualTitle": "DevKit for Strapi",
          "icon": "assets/activity.svg"
        },
        {
          "id": "strapiDevkit.model",
          "name": "Model",
          "contextualTitle": "DevKit for Strapi",
          "icon": "assets/activity.svg"
        },
        {
          "id": "strapiDevkit.configSync",
          "name": "Config Sync",
          "contextualTitle": "DevKit for Strapi",
          "icon": "assets/activity.svg",
          "when": "strapiDevkit.configSync"
        },
        {
          "id": "strapiDevkit.plugins",
          "name": "Plugins",
          "contextualTitle": "DevKit for Strapi",
          "icon": "assets/activity.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "strapiDevkit.routes",
        "contents": "No Strapi routes found yet. DevKit for Strapi lists them as soon as a Strapi project is detected in the workspace.\n[Rescan Workspace](command:strapiDevkit.rescan)",
        "when": "!strapiDevkit.routesFiltered"
      },
      {
        "view": "strapiDevkit.routes",
        "contents": "No route matches the filter.\n[Clear Filter](command:strapiDevkit.routes.clearFilter)",
        "when": "strapiDevkit.routesFiltered"
      },
      {
        "view": "strapiDevkit.model",
        "contents": "No Strapi project detected in this workspace yet.\n[Rescan Workspace](command:strapiDevkit.rescan)"
      },
      {
        "view": "strapiDevkit.health",
        "contents": "No Strapi project detected in this workspace yet.\n[Rescan Workspace](command:strapiDevkit.rescan)"
      },
      {
        "view": "strapiDevkit.plugins",
        "contents": "No plugin found: DevKit lists the local plugins and the ones installed in node_modules once a Strapi project is detected.\n[Rescan Workspace](command:strapiDevkit.rescan)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "strapiDevkit.configSync.export",
          "when": "strapiDevkit.configSyncEntryOpen",
          "group": "navigation@1"
        },
        {
          "command": "strapiDevkit.configSync.import",
          "when": "strapiDevkit.configSyncEntryOpen",
          "group": "navigation@2"
        }
      ],
      "view/title": [
        {
          "command": "strapiDevkit.routes.refresh",
          "when": "view == strapiDevkit.routes",
          "group": "navigation@2"
        },
        {
          "command": "strapiDevkit.routes.showAdmin",
          "when": "view == strapiDevkit.routes && !strapiDevkit.routesShowAdmin",
          "group": "navigation@1"
        },
        {
          "command": "strapiDevkit.routes.hideAdmin",
          "when": "view == strapiDevkit.routes && strapiDevkit.routesShowAdmin",
          "group": "navigation@1"
        },
        {
          "command": "strapiDevkit.routes.filter",
          "when": "view == strapiDevkit.routes",
          "group": "navigation@0"
        },
        {
          "command": "strapiDevkit.routes.clearFilter",
          "when": "view == strapiDevkit.routes && strapiDevkit.routesFiltered",
          "group": "navigation@0"
        },
        {
          "command": "strapiDevkit.health.validateAll",
          "when": "view == strapiDevkit.health",
          "group": "navigation@1"
        },
        {
          "command": "strapiDevkit.refactor.createPlugin",
          "when": "view == strapiDevkit.plugins",
          "group": "navigation@1"
        },
        {
          "command": "strapiDevkit.model.diagram",
          "when": "view == strapiDevkit.model",
          "group": "navigation@1"
        },
        {
          "command": "strapiDevkit.configSync.refresh",
          "when": "view == strapiDevkit.configSync",
          "group": "navigation@1"
        },
        {
          "command": "strapiDevkit.configSync.compare",
          "when": "view == strapiDevkit.configSync",
          "group": "navigation@0"
        },
        {
          "command": "strapiDevkit.configSync.exportAll",
          "when": "view == strapiDevkit.configSync && strapiDevkit.pro",
          "group": "1_db@1"
        },
        {
          "command": "strapiDevkit.configSync.importPick",
          "when": "view == strapiDevkit.configSync && strapiDevkit.pro",
          "group": "1_db@2"
        }
      ],
      "view/item/context": [
        {
          "command": "strapiDevkit.configSync.compare",
          "when": "view == strapiDevkit.configSync && viewItem =~ /^strapiConfigSyncDb\\.(idle|failed|done|same)$/",
          "group": "inline"
        },
        {
          "command": "strapiDevkit.configSync.exportAll",
          "when": "view == strapiDevkit.configSync && viewItem == strapiConfigSyncDb.done",
          "group": "inline"
        },
        {
          "command": "strapiDevkit.configSync.export",
          "when": "view == strapiDevkit.configSync && viewItem == strapiConfigSyncDb.entry",
          "group": "inline@1"
        },
        {
          "command": "strapiDevkit.configSync.import",
          "when": "view == strapiDevkit.configSync && viewItem == strapiConfigSyncDb.entry",
          "group": "inline@2"
        },
        {
          "command": "strapiDevkit.configSync.export",
          "when": "view == strapiDevkit.configSync && viewItem == strapiConfigSyncDb.entry",
          "group": "1_db@1"
        },
        {
          "command": "strapiDevkit.configSync.import",
          "when": "view == strapiDevkit.configSync && viewItem == strapiConfigSyncDb.entry",
          "group": "1_db@2"
        },
        {
          "command": "strapiDevkit.routes.goToHandler",
          "when": "view == strapiDevkit.routes && viewItem == strapiRoute.withHandler",
          "group": "inline"
        },
        {
          "command": "strapiDevkit.routes.copyPath",
          "when": "view == strapiDevkit.routes && viewItem =~ /^strapiRoute/",
          "group": "1_route@1"
        },
        {
          "command": "strapiDevkit.routes.handlerReferences",
          "when": "view == strapiDevkit.routes && viewItem == strapiRoute.withHandler",
          "group": "1_route@3"
        },
        {
          "command": "strapiDevkit.routes.openDeclared",
          "when": "view == strapiDevkit.routes && viewItem =~ /^strapiStep.*\\.declared$/",
          "group": "1_step@1"
        },
        {
          "command": "strapiDevkit.model.copyUid",
          "when": "view == strapiDevkit.model && viewItem =~ /^strapiModel\\.(type|component)/",
          "group": "1_model@1"
        },
        {
          "command": "strapiDevkit.model.showRoutes",
          "when": "view == strapiDevkit.model && viewItem =~ /^strapiModel\\.type/",
          "group": "1_model@2"
        },
        {
          "command": "strapiDevkit.model.openField",
          "when": "view == strapiDevkit.model && viewItem =~ /^strapiModel\\.field/",
          "group": "1_model@1"
        },
        {
          "command": "strapiDevkit.model.openField",
          "when": "view == strapiDevkit.model && viewItem =~ /^strapiModel\\.field\\.relation/",
          "group": "inline"
        },
        {
          "command": "strapiDevkit.health.replace",
          "when": "view == strapiDevkit.health && viewItem == strapiHealth.location.fixable",
          "group": "inline"
        },
        {
          "command": "strapiDevkit.plugins.openConfig",
          "when": "view == strapiDevkit.plugins && viewItem =~ /^strapiPlugin\\.(local|installed)$/",
          "group": "1_plugin@1"
        },
        {
          "command": "strapiDevkit.plugins.openEntry",
          "when": "view == strapiDevkit.plugins && viewItem =~ /^strapiPlugin\\.(local|installed)$/",
          "group": "1_plugin@2"
        },
        {
          "command": "strapiDevkit.plugins.openPackage",
          "when": "view == strapiDevkit.plugins && viewItem == strapiPlugin.installed",
          "group": "1_plugin@3"
        },
        {
          "command": "strapiDevkit.refactor.renameType",
          "when": "view == strapiDevkit.model && viewItem =~ /^strapiModel\\.(type|component)$/",
          "group": "2_pro@1"
        },
        {
          "command": "strapiDevkit.refactor.moveToPlugin",
          "when": "view == strapiDevkit.model && viewItem == strapiModel.type",
          "group": "2_pro@2"
        },
        {
          "command": "strapiDevkit.refactor.renameField",
          "when": "view == strapiDevkit.model && viewItem =~ /^strapiModel\\.field(\\.relation)?$/",
          "group": "2_pro@1"
        },
        {
          "command": "strapiDevkit.refactor.changeRelation",
          "when": "view == strapiDevkit.model && viewItem == strapiModel.field.relation",
          "group": "2_pro@2"
        },
        {
          "command": "strapiDevkit.refactor.renameMethod",
          "when": "view == strapiDevkit.routes && viewItem =~ /^strapiStep\\.handler/",
          "group": "2_pro@1"
        },
        {
          "command": "strapiDevkit.refactor.renameMethod",
          "when": "view == strapiDevkit.plugins && viewItem == strapiPlugin.action",
          "group": "2_pro@1"
        }
      ],
      "commandPalette": [
        {
          "command": "strapiDevkit.configSync.compare",
          "when": "strapiDevkit.configSync"
        },
        {
          "command": "strapiDevkit.configSync.openDiff",
          "when": "false"
        },
        {
          "command": "strapiDevkit.configSync.export",
          "when": "false"
        },
        {
          "command": "strapiDevkit.configSync.import",
          "when": "false"
        },
        {
          "command": "strapiDevkit.configSync.exportAll",
          "when": "strapiDevkit.configSync"
        },
        {
          "command": "strapiDevkit.configSync.importPick",
          "when": "strapiDevkit.configSync"
        },
        {
          "command": "strapiDevkit.configSync.refresh",
          "when": "strapiDevkit.configSync"
        },
        {
          "command": "strapiDevkit.routes.goToHandler",
          "when": "false"
        },
        {
          "command": "strapiDevkit.routes.showAdmin",
          "when": "false"
        },
        {
          "command": "strapiDevkit.routes.hideAdmin",
          "when": "false"
        },
        {
          "command": "strapiDevkit.routes.copyPath",
          "when": "false"
        },
        {
          "command": "strapiDevkit.routes.handlerReferences",
          "when": "false"
        },
        {
          "command": "strapiDevkit.routes.openDeclared",
          "when": "false"
        },
        {
          "command": "strapiDevkit.routes.clearFilter",
          "when": "false"
        },
        {
          "command": "strapiDevkit.model.copyUid",
          "when": "false"
        },
        {
          "command": "strapiDevkit.model.openField",
          "when": "false"
        },
        {
          "command": "strapiDevkit.model.showRoutes",
          "when": "false"
        },
        {
          "command": "strapiDevkit.health.replace",
          "when": "false"
        },
        {
          "command": "strapiDevkit.plugins.openConfig",
          "when": "false"
        },
        {
          "command": "strapiDevkit.plugins.openEntry",
          "when": "false"
        },
        {
          "command": "strapiDevkit.plugins.openPackage",
          "when": "false"
        },
        {
          "command": "strapiDevkit.refactor.renameType",
          "when": "false"
        },
        {
          "command": "strapiDevkit.refactor.renameField",
          "when": "false"
        },
        {
          "command": "strapiDevkit.refactor.changeRelation",
          "when": "false"
        },
        {
          "command": "strapiDevkit.refactor.moveToPlugin",
          "when": "false"
        },
        {
          "command": "strapiDevkit.refactor.renameMethod",
          "when": "false"
        },
        {
          "command": "strapiDevkit.model.diagram",
          "when": "strapiDevkit.hasProject"
        }
      ],
      "editor/context": [
        {
          "command": "strapiDevkit.revealInPanel",
          "when": "strapiDevkit.hasProject && resourceExtname =~ /^\\.(json|[cm]?[jt]s)$/",
          "group": "navigation@99"
        }
      ],
      "explorer/context": [
        {
          "command": "strapiDevkit.revealInPanel",
          "when": "strapiDevkit.hasProject && resourceExtname =~ /^\\.(json|[cm]?[jt]s)$/",
          "group": "navigation@99"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "strapiDevkit.start",
        "title": "Get started with DevKit for Strapi",
        "description": "See your Strapi project as Strapi does: names, routes, model and problems — in the editor and for your AI agent.",
        "steps": [
          {
            "id": "panel",
            "title": "Open the DevKit panel",
            "description": "Health, Routes, Model and Plugins, read from your code.\n[Open the Panel](command:workbench.view.extension.strapiDevkit)",
            "media": {
              "markdown": "assets/walkthrough/panel.md"
            },
            "completionEvents": ["onView:strapiDevkit.health", "onView:strapiDevkit.routes"]
          },
          {
            "id": "completion",
            "title": "Write Strapi calls with completion",
            "description": "Real UIDs, services and routes as you type; unknown names underlined.\n[Show Detected Projects](command:strapiDevkit.showProjects)",
            "media": {
              "markdown": "assets/walkthrough/completion.md"
            },
            "completionEvents": ["onCommand:strapiDevkit.showProjects"]
          },
          {
            "id": "agent",
            "title": "Give your AI agent the same knowledge",
            "description": "The bundled MCP server answers your agent from the project itself.\n[MCP setup](https://devkit-for-strapi.paulrichez.fr/mcp/)",
            "media": {
              "markdown": "assets/walkthrough/agent.md"
            }
          },
          {
            "id": "pro",
            "title": "Refactor safely with Pro",
            "description": "Propagated rename, refactors from the panel, each through the Refactor Preview.\n[Enter License Key](command:strapiDevkit.enterLicenseKey)",
            "media": {
              "markdown": "assets/walkthrough/pro.md"
            },
            "completionEvents": ["onCommand:strapiDevkit.enterLicenseKey"]
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/webview/tsconfig.json",
    "compile-tests": "node esbuild.mjs --tests",
    "test:integration": "node esbuild.mjs --tests && vscode-test",
    "package": "node esbuild.mjs --production && vsce package --no-dependencies",
    "vscode:prepublish": "node esbuild.mjs --production"
  },
  "dependencies": {
    "devkit-for-strapi-core": "workspace:*",
    "devkit-for-strapi-mcp": "workspace:*",
    "devkit-for-strapi-pro": "workspace:*"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/vscode": "^1.101.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "ovsx": "^0.10.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Reading your code works everywhere. Loading your project's Strapi (config-sync diff, export, import) runs its code: only in a trusted workspace.",
      "restrictedConfigurations": [
        "strapiDevkit.configSync.envPath",
        "strapiDevkit.configSync.allowRemoteDatabase",
        "strapiDevkit.configSync.environment"
      ]
    }
  }
}
